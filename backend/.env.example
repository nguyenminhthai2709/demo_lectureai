# LectureAI Backend Configuration
APP_NAME=LectureAI – Multimodal Lecture Intelligence Platform
APP_ENV=development
SECRET_KEY=change-this-to-a-strong-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (SQLite default for local dev; PostgreSQL supported)
DATABASE_URL=sqlite:///./lectureai.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lectureai

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# AI Pipeline Mode: simulated | external_api | local_model
AI_PIPELINE_MODE=simulated
OPENAI_API_KEY=
GEMINI_API_KEY=
WHISPER_MODEL=base
